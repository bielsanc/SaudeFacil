# MySQL do XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saudefacil

# Gere uma chave privada aleatoria com pelo menos 32 caracteres.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
PORT=3000

# Opcional: sem esta chave, frutas continuam funcionando e usam nomes PT fixos no app.
# Para chave DeepL API Free, o servidor usa https://api-free.deepl.com/v2/translate
DEEPL_API_KEY=

# Opcional: endpoint alternativo compatível com Overpass API
# OVERPASS_URL=https://overpass-api.de/api/interpreter
