# Endereço da API Node para o app Expo.
# Web: localhost funciona no mesmo PC. No Expo Go, Android/iOS detectam o host do Metro.
# Se necessário, Android Emulator: http://10.0.2.2:3000/api; celular: IPv4 do PC.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# A chave JWT é exclusiva do backend: configure JWT_SECRET em server/.env
# copiando server/.env.example. Não coloque segredos em variáveis EXPO_PUBLIC_.
